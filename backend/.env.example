GOOGLE_PLACES_API_KEY=
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional. Enables the web-search fallback for finding a hotel's official
# email when website scraping turns up nothing. Without it, /api/hotel/find-email
# simply returns no email and the existing scrape-only behavior is unchanged.
ANTHROPIC_API_KEY=
